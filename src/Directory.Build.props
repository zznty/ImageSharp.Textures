<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup>
    <ProjectCategory>src</ProjectCategory>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <PropertyGroup>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>1.0.0</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageSharp.Textures.Benchmarks" />
    <InternalsVisibleTo Include="ImageSharp.Textures.ILGPU" />
    <InternalsVisibleTo Include="ImageSharp.Textures.Parity.Tests" />
    <InternalsVisibleTo Include="ImageSharp.Textures.Tests" />
    <InternalsVisibleTo Include="ImageSharp.Textures.Vulkan" />
  </ItemGroup>

</Project>
